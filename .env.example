# Provider selection (HUGGINGFACE | OPENAI | LOCAL)
PROVIDER=HUGGINGFACE

# Model provider keys (do NOT commit secrets)
HUGGINGFACE_API_TOKEN=
OPENAI_API_KEY=
LOCAL_LLAMA_SERVER=http://localhost:8080

# Services (for docker-compose)
DATABASE_URL=postgres://agent:password@postgres:5432/agentgpt
REDIS_URL=redis://redis:6379
DOCKER_HUB_REPO=your-dockerhub-username/agentgpt

# Stripe (for marketplace payouts) - never commit real keys
STRIPE_SECRET_KEY=
STRIPE_CONNECT_MODE=manual
