# .env.example additions for incremental PR

# Vector DB selection: pinecone | milvus | faiss-local
VECTOR_DB=faiss-local

# Pinecone (if used) - do NOT commit real keys
PINECONE_API_KEY=
PINECONE_ENV=

# Milvus (if used)
MILVUS_URL=

# Backend URL used by orchestrator to call /run (override in docker-compose if needed)
BACKEND_URL=http://localhost:4000
